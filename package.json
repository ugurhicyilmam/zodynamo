{
  "name": "zodynamo",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "description": "",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build",
    "changeset": "changeset",
    "ci:publish": "changeset publish",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/ugurhicyilmam/zodynamo.git"
  },
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.26.2",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.616.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@trivago/prettier-plugin-sort-imports": "^6.0.1",
    "@tsconfig/recommended": "1.0.7",
    "@types/node": "^20.0.0",
    "prettier": "^3.7.4",
    "tsdown": "0.19.0-beta.3",
    "typescript": "5.5.4",
    "vitest": "^4.0.16"
  },
  "pnpm": {
    "overrides": {
      "prettier": "^3.7.4"
    }
  }
}
